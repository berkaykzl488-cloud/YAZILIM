# Yüklenen dosyalar asla program olarak çalıştırılmaz.
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|shtml|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar .php5 .php7 .php8
  RemoveType .php .phtml .phar
</IfModule>
