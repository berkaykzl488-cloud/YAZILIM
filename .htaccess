# yangpazar.com · kök .htaccess (Apache / LiteSpeed)
# - http → https yönlendirmesi
# - /api/v1/* → api/v1/index.php (mevcut api/*.php dosyaları AYNEN erişilebilir kalır;
#   PayTR Bildirim URL'si /api/paytr_bildirim.php değişmez)
# - app/, storage/ ve geliştirme klasörleri dışarıya kapalı
# - güvenlik başlıkları

Options -Indexes
DirectoryIndex index.php index.html
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # https'e yönlendir (yerel geliştirme hariç)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Kapalı klasörler ve gizli dosyalar (.git, .env …) — .well-known (SSL doğrulaması) açık kalır
  RewriteRule ^(app|storage|tests|tools|docs|node_modules)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(README\.md|composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]

  # API v1 ön denetleyicisi
  RewriteRule ^api/v1/?$ api/v1/index.php [QSA,L]
  RewriteRule ^api/v1/(.+)$ api/v1/index.php [QSA,L]

  # SEO dosyaları: cron bunları site köküne GERÇEK DOSYA olarak yazar (rewrite gerekmez); dosya henüz yoksa API üretir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^sitemap\.xml$ api/v1/index.php?r=seo/sitemap.xml [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^robots\.txt$ api/v1/index.php?r=seo/robots.txt [L,QSA]

  # Temiz adresler (/server/…, /ilan/…, /metin2-tr …) → index.php (sunucu tarafı başlık/meta + uygulama).
  # Çalışmayan sunucularda aynı sayfa /index.php?p=ilan/… ile açılır.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(?!api/|kurulum/|uploads/|assets/)[A-Za-z0-9][A-Za-z0-9_/\-]*/?$ index.php [L,QSA]
</IfModule>

# mod_rewrite yoksa bile klasörler kapalı kalsın (Apache 2.4 / LiteSpeed)
<IfModule mod_alias.c>
  RedirectMatch 403 ^/(app|storage|tests|tools|docs)(/|$)
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://www.paytr.com\")"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # Çerçeve içine alınmayı engelle. (/widget/ eklendiğinde — P1+ — orası için istisna yazılacak.)
  Header always set X-Frame-Options "DENY"
  Header always unset X-Powered-By
</IfModule>

<FilesMatch "\.(env|ini|log|sql|sqlite|bak|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
